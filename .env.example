# Banco de dados Postgres (Neon, provisionado via Vercel Marketplace)
DATABASE_URL=

# IA: chave do OpenRouter (preferida)
OPENROUTER_API_KEY=
# Alternativa: chave da OpenAI direta (só vale se OPENROUTER_API_KEY estiver vazia)
OPENAI_API_KEY=
# Modelo usado nas pesquisas e briefings (padrão: openai/gpt-4.1; com OPENAI_API_KEY, gpt-4.1)
OPENAI_MODEL=openai/gpt-4.1
# Modelo com busca na web, para o radar diário de tendências em /api/cron/tendencias (padrão: perplexity/sonar-pro; exige OPENROUTER_API_KEY)
OPENAI_MODEL_BUSCA=perplexity/sonar-pro

# Autenticação do painel: senha definida pelo usuário e segredo gerado (ex.: openssl rand -base64 32)
DASHBOARD_PASSWORD=
AUTH_SECRET=

# Conta de serviço do Google (Search Console e Google Analytics 4)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Valores fixos do site (SITE_URL é opcional; padrão https://ogpericiacontabil.com.br)
GSC_PROPERTY=
# ID numérico da propriedade GA4 (Admin > Configurações da propriedade); a conta de serviço precisa ser Leitor
GA4_PROPERTY_ID=
SITE_URL=

# Segredo do cron: gere você mesmo (ex.: openssl rand -base64 32) e cadastre na Vercel;
# a Vercel então o envia como Authorization: Bearer ao cron. Já configurado neste projeto.
CRON_SECRET=

# Resend (envio dos emails do CRM e da newsletter). Opcional: sem a chave e o remetente, a tela diz "Resend não conectado".
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Oliveira Guimarães <contato@ogpericiacontabil.com.br>
RESEND_REMETENTE=
# Para onde vão as respostas dos emails (opcional).
RESEND_RESPONDER_PARA=
# Segredo de assinatura do webhook do Resend (Webhooks > Signing Secret, começa com whsec_).
RESEND_WEBHOOK_SECRET=
# Emails por dia no plano do Resend (padrão 90; o plano gratuito permite 100).
RESEND_LIMITE_DIARIO=
# Token do webhook do formulário do site (gere com: openssl rand -hex 32). Sem ele, o webhook recusa tudo.
SITE_WEBHOOK_TOKEN=
# Link do WhatsApp do escritório (ex.: https://wa.me/55...). Opcional: entra no lugar de [link do WhatsApp] nos emails prontos dos funis.
WHATSAPP_LINK=

# Descadastro público (Resend): segredo do HMAC do token e URL pública do painel.
DESCADASTRO_SEGREDO=
URL_PUBLICA_PAINEL=https://claudio-psi-lime.vercel.app
