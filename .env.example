# Banco de dados Postgres (Neon, provisionado via Vercel Marketplace)
DATABASE_URL=

# Conta OpenAI
OPENAI_API_KEY=
# Modelo usado nas pesquisas (padrão: gpt-4.1)
OPENAI_MODEL=gpt-4.1

# Autenticação do painel: senha definida pelo usuário e segredo gerado (ex.: openssl rand -base64 32)
DASHBOARD_PASSWORD=
AUTH_SECRET=

# Conta de serviço do Google (Search Console)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Valores fixos do site
GSC_PROPERTY=
SITE_URL=

# Injetado automaticamente pela Vercel para as rotas de cron
CRON_SECRET=
