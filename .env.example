# Banco de dados Postgres (Neon, provisionado via Vercel Marketplace)
DATABASE_URL=

# IA: chave do OpenRouter (preferida)
OPENROUTER_API_KEY=
# Alternativa: chave da OpenAI direta (só vale se OPENROUTER_API_KEY estiver vazia)
OPENAI_API_KEY=
# Modelo usado nas pesquisas e briefings (padrão: openai/gpt-4.1; com OPENAI_API_KEY, gpt-4.1)
OPENAI_MODEL=openai/gpt-4.1
# Modelo com busca na web, para a pesquisa diária de tendências (padrão: perplexity/sonar-pro)
OPENAI_MODEL_BUSCA=perplexity/sonar-pro

# Autenticação do painel: senha definida pelo usuário e segredo gerado (ex.: openssl rand -base64 32)
DASHBOARD_PASSWORD=
AUTH_SECRET=

# Conta de serviço do Google (Search Console)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Valores fixos do site (SITE_URL é opcional; padrão https://ogpericiacontabil.com.br)
GSC_PROPERTY=
SITE_URL=

# Segredo do cron: gere você mesmo (ex.: openssl rand -base64 32) e cadastre na Vercel;
# a Vercel então o envia como Authorization: Bearer ao cron. Já configurado neste projeto.
CRON_SECRET=
